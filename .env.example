# Copy to .env.local for local testing; on Vercel set these in Settings → Environment Variables.
# Resend API key (resend.com → API Keys). Required for the demo and booking forms to send.
RESEND_API_KEY=
# Optional: sender on a domain verified in Resend (default below).
FORMS_FROM="Forest Media Récords <formularios@forestmediarecords.com>"
# Optional: inbox that receives the forms (default: contactEmail in data/site.ts).
FORMS_TO=
